# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/mahall_system

# Authentication
JWT_SECRET=super_secret_jwt_key_mahall_connect_2026_secure_random
JWT_EXPIRES_IN=7d
COOKIE_SECRET=mahall_cookie_secret_key_ultra_secure

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Storage (S3 compatible placeholder)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment Gateway (Razorpay/Stripe placeholder)
PAYMENT_KEY=rzp_test_placeholder_key
PAYMENT_SECRET=rzp_test_placeholder_secret
